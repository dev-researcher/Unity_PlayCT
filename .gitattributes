# Keep Unity text assets and sources LF on every platform so YAML and .meta files diff and merge cleanly.
*.cs        text eol=lf
*.asmdef    text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.meta      text eol=lf
*.unity     text eol=lf
*.asset     text eol=lf
*.mat       text eol=lf
*.prefab    text eol=lf
*.inputactions text eol=lf
*.png       binary
*.jpg       binary
*.fbx       binary
*.wav       binary
*.mp3       binary
